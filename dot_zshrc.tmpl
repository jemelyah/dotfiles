# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
# ZSH_THEME="robbyrussell"
plugins=(git)


source $ZSH/oh-my-zsh.sh
source {{ template "brew-prefix" . }}/opt/fzf/shell/key-bindings.zsh
# source ~/history-search.zsh

export EDITOR='nvim'

# Evals
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
eval "$(mise activate zsh)"

# Bindings

# File system
alias ls='eza -lh --group-directories-first --icons=auto'
alias lsa='ls -a'
alias lt='eza --tree --level=2 --long --icons --git'
alias lta='lt -a'
alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
alias cd="zd"
zd() {
  if [ $# -eq 0 ]; then
    builtin cd ~ && return
  elif [ -d "$1" ]; then
    builtin cd "$1"
  else
    z "$@" && printf "\U000F17A9 " && pwd || echo "Error: Directory not found"
  fi
}
open() {
  xdg-open "$@" >/dev/null 2>&1 &
}

# Directories
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Tools
alias d='docker'
alias r='rails'
n() { if [ "$#" -eq 0 ]; then nvim .; else nvim "$@"; fi; }
# alias ghe="gh copilot explain"
# alias ghs="gh copilot suggest"

# Git
alias g='git'
alias gcm='git commit -m'
alias gcam='git commit -a -m'
alias gcad='git commit -a --amend'

# Compression
compress() { tar -czf "${1%/}.tar.gz" "${1%/}"; }
alias decompress="tar -xzf"


# bun completions
[ -s "/Users/jemelyah/.bun/_bun" ] && source "/Users/jemelyah/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# Bitwarden (personal/work kept as fully separate CLI sessions, each with its own BW_SESSION)
bw-personal() { BITWARDENCLI_APPDATA_DIR=~/.config/bw/personal BW_SESSION="$BW_SESSION_PERSONAL" bw "$@" }
bw-work() { BITWARDENCLI_APPDATA_DIR=~/.config/bw/work BW_SESSION="$BW_SESSION_WORK" bw "$@" }
bwu() {
  case "$1" in
    personal) export BW_SESSION_PERSONAL=$(BITWARDENCLI_APPDATA_DIR=~/.config/bw/personal bw unlock --raw) ;;
    work) export BW_SESSION_WORK=$(BITWARDENCLI_APPDATA_DIR=~/.config/bw/work bw unlock --raw) ;;
    *) echo "usage: bwu personal|work" >&2; return 1 ;;
  esac
}
export PATH="/Users/jemelyah/.local/bin:$PATH"

{{ if eq .profile "work" -}}
# Work: eazyherd, Atlassian products, JVM, gcloud, nvm, qlty
export PATH="$HOME/bin:$PATH"
export LANG=en_US.UTF-8
export CLICOLOR=1
export LSCOLORS=ExFxCxDxBxegedabagacad
alias git='LANG=en_GB git'

alias jira="$HOME/java/atlassian-jira-software-9.12.5-standalone/bin/start-jira.sh -fg"
alias jira917="$HOME/java/atlassian-jira-software-9.17.0-standalone/bin/start-jira.sh -fg"
alias confluence="$HOME/java/atlassian-confluence-8.9.5/bin/start-confluence.sh -fg"
alias confluence720="$HOME/java/atlassian-confluence-7.20.3/bin/start-confluence.sh -fg"
alias killjira="ps -ax | grep jira | awk -F' ' '{print $1}' | xargs kill -9"
alias killz="kill -9 %1"

export PATH="$PATH:$HOME/java/atlassian-plugin-sdk/bin"
# mise sets JAVA_HOME, globally and per project. Switch the shell with `mise shell java@temurin-11`.
export JAVA_OPTS="-Xms2g -Xmx3g -XX:ReservedCodeCacheSize=300m -Dfile.encoding=UTF-8"

source "{{ template "brew-prefix" . }}/share/google-cloud-sdk/path.zsh.inc"
source "{{ template "brew-prefix" . }}/share/google-cloud-sdk/completion.zsh.inc"

export NVM_DIR="$HOME/.nvm"
[ -s "{{ template "brew-prefix" . }}/opt/nvm/nvm.sh" ] && . "{{ template "brew-prefix" . }}/opt/nvm/nvm.sh"
[ -s "{{ template "brew-prefix" . }}/opt/nvm/etc/bash_completion.d/nvm" ] && . "{{ template "brew-prefix" . }}/opt/nvm/etc/bash_completion.d/nvm"

source ~/rails/eazybi/bin/git_helpers.sh

[ -s "{{ template "brew-prefix" . }}/share/zsh/site-functions/_qlty" ] && source "{{ template "brew-prefix" . }}/share/zsh/site-functions/_qlty"
export QLTY_INSTALL="$HOME/.qlty"
export PATH="$QLTY_INSTALL/bin:$PATH"
{{- else -}}
# Dev plugin profile: plugins other than playwright are enabled only for sessions under ~/parachutes
claude() {
  if [[ $PWD == $HOME/parachutes* ]]; then
    command claude --settings ~/.config/claude/dev-plugins.json "$@"
  else
    command claude "$@"
  fi
}
{{- end }}
