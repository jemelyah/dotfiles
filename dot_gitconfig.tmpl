# This is Git's per-user configuration file.
[user]
	name = Aleksandr Emelianov
	email = jemelyah@gmail.com
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
{{ if eq .profile "work" }}
[includeIf "gitdir/i:~/rails/"]
	path = ~/.config/git/work
[includeIf "gitdir/i:~/rubygems/"]
	path = ~/.config/git/work
[includeIf "gitdir/i:~/java/"]
	path = ~/.config/git/work
{{ end -}}
