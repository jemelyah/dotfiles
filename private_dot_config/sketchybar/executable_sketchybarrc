#!/bin/bash
CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"
FONT="JetBrainsMono Nerd Font"

sketchybar --bar height=32 \
                 position=top \
                 color=0xe61e1e2e \
                 border_width=0 \
                 corner_radius=9 \
                 margin=6 \
                 y_offset=4 \
                 padding_left=8 \
                 padding_right=8 \
                 blur_radius=30 \
                 topmost=window

sketchybar --default \
  icon.font="$FONT:Bold:13.0" \
  icon.color=0xffcdd6f4 \
  icon.padding_left=6 \
  icon.padding_right=4 \
  label.font="$FONT:Regular:13.0" \
  label.color=0xffcdd6f4 \
  label.padding_left=4 \
  label.padding_right=6 \
  background.height=24 \
  background.corner_radius=6 \
  background.padding_left=2 \
  background.padding_right=2 \
  background.drawing=off

sketchybar --add event aerospace_workspace_change

for sid in browser terminal obsidian logos music; do
  sketchybar --add item space.$sid left \
    --subscribe space.$sid aerospace_workspace_change \
    --set space.$sid label="$sid" \
                     script="$PLUGIN_DIR/aerospace.sh" \
                     click_script="aerospace workspace $sid"
done

sketchybar --add item divider left \
  --set divider icon="|" \
               icon.color=0xff585b70 \
               icon.padding_left=6 \
               icon.padding_right=6 \
               label.drawing=off

sketchybar --add item battery right \
  --set battery update_freq=30 script="$PLUGIN_DIR/battery.sh"

sketchybar --add item clock right \
  --set clock update_freq=10 icon.drawing=off script="$PLUGIN_DIR/clock.sh"

sketchybar --add item layout right \
  --subscribe layout aerospace_workspace_change \
  --set layout icon.drawing=off script="$PLUGIN_DIR/layout.sh"

sketchybar --add item volume right \
  --subscribe volume volume_change \
  --set volume script="$PLUGIN_DIR/volume.sh"

sketchybar --update
