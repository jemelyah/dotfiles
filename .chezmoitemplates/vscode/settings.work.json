{
    "editor.inlineSuggest.enabled": true,
    "editor.fontFamily": "JetBrains Mono for Powerline, Martian Mono, Menlo, Monaco, 'Courier New', monospace",
    "editor.fontSize": 14,
    // "editor.lineHeight": 20,
    // "editor.fontVariations": "'wdth' 100, 'wght' 100",
    "workbench.fontAliasing": "auto",
    "workbench.iconTheme": "vscode-icons",
